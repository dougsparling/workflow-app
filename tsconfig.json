{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@hooks/*": ["./src/hooks/*"],
      "@components/*": ["./src/components/*"],
      "@design/*": ["./src/design/*"],
      "@domain/*": ["./src/domain/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@workflow/*": ["./src/workflow/*"],
      "@store/*": ["./src/store/*"],
      "@util/*": ["./src/util/*"],
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
